 "blocks": [
  {
   "id": "kataguchi-yasunosuke-915580-0001",
   "pid": "915580",
   "pages": [
    8
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "調布にて麥の畑に立ちてさびしき女なり麥のはたけはただに靑しもわが心いささかの友のあやまち責めたればあやしくもうれしわれの心は",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0002",
   "pid": "915580",
   "pages": [
    9
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "いささかの友のあやまちかりそめにおもひすごさば苦しからむぞいささかのあやまちなりと友はいへどあきらめかねつ友をいかれりいささかの友のあやまち見すぐしてあらばあるべきわれにあらなくこれの世に生けらく友をよろこびぬそのあやまちを友はあやまり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0003",
   "pid": "915580",
   "pages": [
    10
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "わが友とわれの心はよろこびてたぬしき春の淺夜とぞなる深川のうたうすくもる枯草原のはて遠く見えてさびしも朝のけむりは",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0004",
   "pid": "915580",
   "pages": [
    11
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "朝あけの枯草原を吹きとほりこのさ庭べに落つる風かも雀子はすずめ子とをりむつまじき枯草原のうすき朝霧ひとたびは逢ひてふたたび見まじかる人にものいふ朝のさびしさ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0005",
   "pid": "915580",
   "pages": [
    12
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "棗のうたはろばろと山東省より送り來し黑き棗を食む夕かな",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0006",
   "pid": "915580",
   "pages": [
    13
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "うまければうましとぞいひ棗の實いまは三つも食べにけるかな",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0007",
   "pid": "915580",
   "pages": [
    14
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "晝床晝床になまけてゐつついまは久し晝餉の時となりにけるかも晝床のひとりわが身のぬくもりにこもりておもふ白飯のこと",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0008",
   "pid": "915580",
   "pages": [
    15
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "靑竹の雨衣ほす靑竹の幹雨はれて靑竹の幹露たまるみゆくもり日の部屋に焚きたる線香の音はなけれどくづれけるかも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0009",
   "pid": "915580",
   "pages": [
    16
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "日光の歌停車場を出づれば寒しいちめんに降りたる雪の夜目に𛁈るしも夜のくだち宿にいらむと降る雪の町をいそげば腹すきにけりこれやこの匠が彫りしねぶり猫ねぶり深しと見て立てりけり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0010",
   "pid": "915580",
   "pages": [
    17
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "これやこの匠のいのちこもらへる猫はかしこし眼をつぶりたる現し世の人がつくりしねぶり猫さながらねぶり幾代をか經しはやち風吹きすぐる間を岩かげにかくらひゐつつ身のあはれなり大岩のかげにかくりてあなといへばおほ岩の上を風はしりたれ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0011",
   "pid": "915580",
   "pages": [
    18
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "われとわがちからかなしみ岩かげにかくらひきけば山風の音足曳の山のまほらを晝見ればおほき垂氷のならびさびしも足曳の山の峡をゆく人の馬曳きながら行きにけるかも天ぎらし降る雪の峡を馬曳きて下りゆく人のありてさびしき",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0012",
   "pid": "915580",
   "pages": [
    19
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "いきものの馬を曳きつつ山かげを人ゆきしより山はさびしも山かげにただひとすぢの路ありて馬のとほれば馬の脚あと天つ日の光こぼれて山かげをもとほりゆけば身もかすかなり山かげの葉洩るる光まさびしみ木棚に寄りマッチ擦りたれ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0013",
   "pid": "915580",
   "pages": [
    20
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "天霧ふ雪の山路を遠く來つ人にあはねばかなしきろかも足曳の山かげ遠く行きはてつ吾が戀ふらくは人間の聲足曳の山の寒さに身は冷えていまだも人に逢ふすべはなし崖の上を見ればさびしも崖の上に山の鳥ゐて尾を振れるなり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0014",
   "pid": "915580",
   "pages": [
    21
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "山の鳥わが眼のまへにあらはれてねをこそ鳴かね尾を振りにけり山の鳥わがとほるべき路の上に風に吹かれて飛び立つあはれ東京の𛁈るべにはがきやらむとて山のポストにいそぎけるかも寒寒とかぐろみ光る湖のその空とほく夕月の見ゆ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0015",
   "pid": "915580",
   "pages": [
    22
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "久方の天のも中に立てる山𛁈づかに湖をいだくなりけり草枕旅のやどりに早ねすと遠山なりをきけばさびしも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0016",
   "pid": "915580",
   "pages": [
    23
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "あかつきをひとりめざめてありければ枕にひびけ山なりの音朝ばれの濱に氷れる眞白雪踏みつつ遠く行かざりにけり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0017",
   "pid": "915580",
   "pages": [
    24
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "凪ぎはてし湖の岸べに舟つきて人らはたらく朝のひかりに朝あけの松の木の間にあらはれてふたりのわらべ湖を眺むる𛁈まらくは岩にとどまりわが行かむ目下の路を見れば嶮しき高圓の深山の峡に見し鳥のさびしき姿忘られなくに(旅のをはりによめる)",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0018",
   "pid": "915580",
   "pages": [
    25
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "動物園所見春の陽に光りて遊ぶこの雉子はいつくしくして一聲も啼かぬ眞晝日の樹かげにうつらゐる駱駝眼つぶりてゐたりけるかも日の光さびしくもあるか大駱駝眼をば開けたりその眼を細く",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0019",
   "pid": "915580",
   "pages": [
    26
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "おのつからさびしくなりて大駱駝眼ひらくを見て立ちにけり春日行春淺き野中に立てる群竹の枯葉のそよぎ見てすぎにけり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0020",
   "pid": "915580",
   "pages": [
    27
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "赤羅ひく眞日の光のいつぱいに竹の林に流れたる見ゆ曉の並倉かげのひとところひとすぢの光流れて明し朝あけの光さしたる並倉のかげをとほりてさびしくもあるか",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0021",
   "pid": "915580",
   "pages": [
    28
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "煙突天の星まばらに見えてけむりだし白きけむりを流しけるかも火事の鐘眼はさめてぬくもりにたる床ぬちにこの警鐘をきく人もあれ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0022",
   "pid": "915580",
   "pages": [
    29
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "凝り𛁈づむさ夜の空氣をゆるがすや遠街の鐘に眼はさめにけり警鐘の鳴りのつのりにうつつなにねむれる妻を見らくさびしも赤羅ひく晝の光に木の竝葉照りそよぎつつ春は來にけりさ庭べのもろもろの樹に沁み入らく光を見れば春は來にけり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0023",
   "pid": "915580",
   "pages": [
    30
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "荒磯の岩朝ぼらけ荒磯の岩に碎け散るこの白浪を見ればさぶし𛁈これやこの越の邊土の浦曲はも風いや寒く波騒ぐなり北の海荒磯の岩に白浪の碎けて散れどゆく舟もなし",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0024",
   "pid": "915580",
   "pages": [
    31
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "さえさえと庭木に風の音寒し晝地震さりしこの𛁈づけさに月讀の空の明りに坂をゆきはるかに見しか一本の松夜を寒みいよよ更けたる月かげに一本松を見るあはれなり久方の月夜に立てるひとつ松ひとりながめていよよ寂しき",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0025",
   "pid": "915580",
   "pages": [
    32
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "雪だるまつくるはよしも𛁈かはあれど寒きあしたは風ひくなゆめ(愛弟靖四郞に)かすかなる火をばあつめて火をつくる妻をあはれに思ひそめしかはしけやし妹が目離れてひとりぬる夜寒のなげき人は知らじな(以下一月作)庭松の枝につもれる晝の雪かすかに散らふ音聞ゆなり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0026",
   "pid": "915580",
   "pages": [
    33
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "𛁈めやかに妹と語らふ夜の更けて窓はほのかに雪あかりすも大正五年作",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0027",
   "pid": "915580",
   "pages": [
    34
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "挽歌大正五年一月十日わが祖父はゆきぬひつそりと病室の戶をあけにつつカンフルの香を悲しみにけり病室のあまり明ければ電燈を𛁈ろき布もておほひけるかな死にいそぐ眼をほそぼそとあけたまふ祖父に申さむ言なしあはれ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0028",
   "pid": "915580",
   "pages": [
    35
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "わが祖父の出で入る氣息の𛁈かすがに死に近づくと𛁈づもりにけりこれやこの死人の眼にはなみだなし死人の顏はきよらなるかも葬むりの野路をいゆけばひとすぢの水さむざむと流れてゐたり睦月の天にながらふ烟見ゆいまかも祖父は燃えたまふらむ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0029",
   "pid": "915580",
   "pages": [
    36
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "わが祖父を燒くべき家か風寒き野のはてにしてひとつなりけり遠天に立てらく高嶺雪に光り葬むりてかへる道はかなしも睦月の今宵の天のいつくしく骨あげはいまをはりなりけり霜解の路をよけつつ萱山の萱に音させいりにけるかも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0030",
   "pid": "915580",
   "pages": [
    37
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "天の原不盡の遠嶺をたまさかに吾妹とならび見らくよろしも輝ぎれのあかくなりたる手をさすりあな痛しもと妻はいひしか朝寒のくりやにものをきざむ子にキャベッなりやといひしわれかも𛁈んとしてさ夜降る雪の積みぬらしいまだもい寢ず聞けり汽笛を",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0031",
   "pid": "915580",
   "pages": [
    38
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "いりつ陽の渺と照りたる空のもと椿一樹の花をば見たれ深ぶかと葉かげ暗けど紅椿あかきその花おのおの光り久方の光ささねば下枝の花はさびしく見えにけるかも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0032",
   "pid": "915580",
   "pages": [
    39
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "病院の歌日もすがら降りゐる雨に濡れとほり雀むらがり遊べるが見ゆ十方世界あまねき光𛁈たひつつ病みぬればこそ床の上にあれあたらしき家の屋根べに人のぼり布團乾すらしも夏の光に",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0033",
   "pid": "915580",
   "pages": [
    40
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "葉櫻の梢をたかみさくらんぼ人に知られず熟れにけるかも朝木原𛁈つとりとしてさ霧下りうごかぬ木木のくろぐろと見ゆ𛁈かすがに雨にぬれたる小すずめの行くへさびしと見やりけるかもいつの日かいゆべき身ぞと細りたる手をしさすれば生けりともなし",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0034",
   "pid": "915580",
   "pages": [
    41
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "おぼろおぼろ霧らへる空の高き樹の上枝さびしくゆれゐるが見ゆやうやくにかうべあぐれば靑空に光みなぎるに淚ながれぬうつし世の鴉なれども金色の夕日のなかに光るなりけりたまさかに病やすらになりぬればものいひたさの心湧きたれ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0035",
   "pid": "915580",
   "pages": [
    42
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "夜は深し身ぬちの痛さ訴ふべき人しあらねば吾は泣きにけり栂の木に夕陽片照り風吹けば上枝かそけく空にゆるるも隣室の患者の病重からし咳きいる聲の苦しく聞ゆひんがしにほのかほのかに枇杷いろの月のぼるよといふは誰が子ぞ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0036",
   "pid": "915580",
   "pages": [
    43
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "朝床に病む身いたはり街の上をおほきく飛べる飛行機を見し地に碎け死なむいのちとさだめつつ空飛ぶ人の心愛しも霧ふかき屋根に來りて朝がらす怪しく鳴けば心くらしもかぎろひのゆふべ樹に鳴く蟬の聲ただひとつなり流るるごとし",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0037",
   "pid": "915580",
   "pages": [
    44
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "硝子戶に雨の𛁈ぶきの𛁈きりなく流れ流れて夜は更けにけり病やや安らになれば夏の日はいよいよ永く思はれにけりひさびさにかへり來ればさるすべりあかあか見えて夏はふかしも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0038",
   "pid": "915580",
   "pages": [
    45
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "立山の歌山のかげいよいよ深くなりぬらし曉寒く身は冷えにけり朝がすみ晴れゆくなべにうららうらら朝日子のぼる山のあなたに日もすがら深山鶯啼く山の杣路をゆけば心たぬしも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0039",
   "pid": "915580",
   "pages": [
    46
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "山かげに湧きて流るる岩清水草鞋ひたして渡りけるかものぼりこし山はいよいよ高からし岩這ひつたふはひ松の見ゆ天の戶を吹き捲く夜風寒ざむと雪原にいでて尿せるかも積む雪のはだらのところ高山の草は草とし花咲けるかも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0040",
   "pid": "915580",
   "pages": [
    47
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "晃晃と輝く嶺の白雪はあやにかしこし踏みがてぬかも見はるかす山の峽に灯は遠しかすかに人の住めるにかあらんすがすがし竹の林に雨はれて細きその葉はそよがざりけり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0041",
   "pid": "915580",
   "pages": [
    48
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "夕の黑土ところ狹き庭にしあれど𛁈みじみと眼には𛁈たしき夕の黑土ははそはの母をだいじと思ひつつ音づれ絕えて幾日經にけんたらちねの母が賜ひし夏衣著る日を知らずいたづらに病む",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0042",
   "pid": "915580",
   "pages": [
    49
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "八衢の宵の灯かげに虫賣の女はとほる賣るとはなしにおのつからさびしくなりて八衢の籠に鳴く蟲を聞きけるものか蟲賣の籠に鳴く蟲の聲聲のちまたに遠く行きてさびしき足曳の山にこもらひ音すなり人をりて山の木を挽くらむか",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0043",
   "pid": "915580",
   "pages": [
    50
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "𛁈ぐれの雨はれゆくなべにきらきらし穗すすきゆらぎ日はさしにけり𛁈ぐれの雨ふりてはれたる庭の木に夕の鳥を見ればさぶしき(十一月作)大正四年作",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0044",
   "pid": "915580",
   "pages": [
    51
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "大極殿のうた夕まけて大極殿の朱のいろひつそりと吾が見て立てりけり洲崎小景くるわ近き海なみたたず日輪はいまぞ𛁈づかに輝けるなる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0045",
   "pid": "915580",
   "pages": [
    52
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "ひろびろとくるわの通り廣ければ自轉車に乘り子らはあそべりうそ寒き海の夕陽をそがひにし堤にのぼりくるわ見たるもまんまんと光たたゆるきさらぎの海を背にして歩むおいらん夜となれどここのくるわは灯ともさずさびしきかもよひとり歩めば",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0046",
   "pid": "915580",
   "pages": [
    53
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "きさらぎの午後の光のなかにして童女泣きつつ歩みゐたるも小田原の歌きさらぎの雨にぬれては光りつる小石小石を踏みつつゆけり(石渡君に)",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0047",
   "pid": "915580",
   "pages": [
    54
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "くろぐろとひとら渚にあつまりて火を焚けるなりさびしくあるか相模の海白銀の波きららかに光るところ伊豆の大島いま見つるかも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0048",
   "pid": "915580",
   "pages": [
    55
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "おほらかに岩や起き臥す崖したに相模の子らの遊べるあはれこれやこの相模の國は山のみちくねんぼを賣る女ありけりつややかに光るくだものさびしろの女ひさげば吾も買ひにけり危げに崖下のぞきくねんぼを投ぐれば子らの拾ふなりけり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0049",
   "pid": "915580",
   "pages": [
    56
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "妻を思ふうた小夜の風いたくな吹きそ吾妹いまかはやにゆくと庭に下りたるさ夜中と夜は更けたれどぱつちりと眼をみひらける子はいつくしきほのぼのと朝あけぬらし愛し子の面わ汗ばみねむれるが見ゆ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0050",
   "pid": "915580",
   "pages": [
    57
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "あひ見てののちの心にいささかも悔はあらずといひにけらずやくひ入るがごとき悲しきこころもて妻にむかへばわかれかねつもまことわれうつつなかりきいとしごをのこして家をいでて來ければ𛁈じまなるくぬぎはやしのさぶしさに人はとほしと歎きけるかも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0051",
   "pid": "915580",
   "pages": [
    58
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "天の原ふりさけ見ればまさやかに月てりみちて妹とほきかも博覽會ひとりし見ればさびしとて土人形を買ひにけるかも木洩れ日はあかるくさびし傾斜地をのぼりて草にすわりけるかもいや深に𛁈げれる峽の木下やみ赤き實食めばさびしくもあるか",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0052",
   "pid": "915580",
   "pages": [
    59
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "はるかなる早稻田の末に落つる日の光さびしみすぎにけるかも綠なる早稻田のなかに吾が行かむみちはろかにも𛁈ろじろと見ゆ大日の𛁈づもりて山にいるところ人に知らえず見て立ちにけり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0053",
   "pid": "915580",
   "pages": [
    60
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "大正三年作",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0054",
   "pid": "915580",
   "pages": [
    61
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "東京に來りて砂風に吹かれふかれて川岸をあゆめばさくらの花散りにちる(江戶川)東京の風はかなしや吹きふきて川岸のさくらに砂ほこりつむ靑葉若葉いとも𛁈づかに日にぬれて輝きやまず生きをうれしむ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0055",
   "pid": "915580",
   "pages": [
    62
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "ふところにかい抱きやればすやすやと寢いる小犬は人のごとしもまともにぞ疾風吹きふくわが家は木の葉と空に飛ぶにあらずやいつさんに風吹く坂をはしりたれ月もはしれり雲もはしれりかなたなる都の空の灯あかりの眸に𛁈みきてさびしまれけり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0056",
   "pid": "915580",
   "pages": [
    63
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "𛁈づくして月は木ぬれに匂ふよりこころ眞珠とすみて光るも僧院のうたま珠なす水瀨に兩の足ひたしうつつともなくありしひととき",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0057",
   "pid": "915580",
   "pages": [
    64
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "まはだしとなりて水瀨をわがわたるさびしき足の𛁈ろじろと見ゆさびしさよ風靑靑と木のうれをながるるあした雉子啼くなり風の音かあらず水の音かいちやうにただあをあをとあさあけにけり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0058",
   "pid": "915580",
   "pages": [
    65
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "京都にてなんといふこは現世のさびしさぞ夜更けを三味の鳴りもいでけるはなやげる四條通にいでたればはれがましやといひし君かな",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0059",
   "pid": "915580",
   "pages": [
    66
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "戶山ヶ原ひもすがら霧雨ふれば茄子畑の代赭の色も眼にさびしけれ林の歌秋深き林にわれの驚きは𛁈んじつ燃ゆるその赤き帶",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0060",
   "pid": "915580",
   "pages": [
    67
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "秋野原夕こえくれば𛁈ん𛁈んと蔭をひきけるはやしを見たり朝の不盡をよめるひとり寢の床ゆ起きいで不盡の根の𛁈づけさにむかへばただに尊し",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0061",
   "pid": "915580",
   "pages": [
    68
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "あら尊とあしたの不盡にさしむかひいふことばなくくちつぐみけり瞳あぐれば白妙の不盡ま𛁈ろにぞ朝窓にうつりたふとかりけり歸省の歌夜の海を見るとて汽車の窓によればガラスつめたくぬかにふれたり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0062",
   "pid": "915580",
   "pages": [
    69
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "見はるかす碓氷の山は霧ふかみ樹樹もみぢしつ秋ふかみかも秋がゆくかなしさにわが見いりたる夕草むらの野菊ぞあはれあはつけく一脉の光ながれたる楢のはやしにいのちさびしむ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0063",
   "pid": "915580",
   "pages": [
    70
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "桐のうた秋の陽はいりがてにして片照れば桐の葉ゆらら輝けるなりこんじきの桐のひろ葉はほがらかにさんらんとして光るなりけりうす光る霜月の畑にすいすいと今日もさびしく鳴く虫のあり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0064",
   "pid": "915580",
   "pages": [
    71
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "はてしなき秋芝の丘をわが赤犬とはせまはりたれ夕陽あかきに歸省のうた汽車の窓にふるさとの山脉おほらかに雪に光りつ見えそめにけれ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kataguchi-yasunosuke-915580-0065",
   "pid": "915580",
   "pages": [
    72
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "かなしさのまぎらはすべきすべをなみまた汝が面に見いるなりけり黎明の光ただよふ部屋のうち眼ざめぬなれを見いでつるかも波に生れ波に死ぬとふあはれにも白き鷗はなつかしきかも",
   "sachu": "",
   "poems": []
  }
 ],
